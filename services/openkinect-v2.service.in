[Unit]
Description=OpenKinect v2 multi-stream host service
After=local-fs.target systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
EnvironmentFile=-@OPENKINECT_CONFIG_FILE@
ExecStart=@OPENKINECT_RUNNER_PATH@
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
Alias=kinect-webcam.service