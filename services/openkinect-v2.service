[Unit]
Description=OpenKinect v2 multi-stream host service
After=local-fs.target systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
EnvironmentFile=-/etc/openkinect-v2/openkinect-v2.conf
ExecStart=/usr/libexec/openkinect-v2/openkinect-v2-runner.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
Alias=kinect-webcam.service
