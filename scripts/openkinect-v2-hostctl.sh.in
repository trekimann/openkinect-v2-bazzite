#!/bin/bash
set -euo pipefail

SERVICE="${OPENKINECT_SERVICE:-openkinect-v2.service}"
AUDIO_STATUS_SCRIPT="${OPENKINECT_AUDIO_STATUS:-@OPENKINECT_AUDIO_STATUS_PATH@}"
CONFIG_FILE="${OPENKINECT_CONFIG:-@OPENKINECT_CONFIG_FILE@}"

safe_config_path() {
  local resolved_path
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config file not found: $CONFIG_FILE" >&2
    exit 1
  fi

  resolved_path="$(realpath "$CONFIG_FILE")"

  case "$resolved_path" in
    /etc/openkinect-v2/*) ;;
    *)
      echo "Refusing to read config outside /etc/openkinect-v2" >&2
      exit 1
      ;;
  esac

  CONFIG_FILE="$resolved_path"
}

usage() {
  cat <<USAGE
Usage: $(basename "$0") [start|stop|restart|status|logs|audio-status|config|mode <color|ir|depth|all>|depth-colors <near> <mid> <far>]
USAGE
}

is_hex_color() {
  [[ "$1" =~ ^#[0-9A-Fa-f]{6}$ ]]
}

run_elevated() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

reload_service_runtime() {
  run_elevated systemctl kill -s HUP "$SERVICE"
}

set_mode() {
  local mode="$1"
  local enable_color=0
  local enable_ir=0
  local enable_depth=0

  case "$mode" in
    color)
      enable_color=1
      ;;
    ir)
      enable_ir=1
      ;;
    depth)
      enable_depth=1
      ;;
    all)
      enable_color=1
      enable_ir=1
      enable_depth=1
      ;;
    *)
      echo "Unknown mode: $mode" >&2
      usage >&2
      exit 1
      ;;
  esac

  safe_config_path

  run_elevated sed -i \
    -e "s/^ENABLE_COLOR=.*/ENABLE_COLOR=$enable_color/" \
    -e "s/^ENABLE_IR=.*/ENABLE_IR=$enable_ir/" \
    -e "s/^ENABLE_DEPTH=.*/ENABLE_DEPTH=$enable_depth/" \
    "$CONFIG_FILE"

  run_elevated systemctl restart "$SERVICE"
  exit $?
}

set_depth_colors() {
  local near_color="$1"
  local mid_color="$2"
  local far_color="$3"

  if ! is_hex_color "$near_color" || ! is_hex_color "$mid_color" || ! is_hex_color "$far_color"; then
    echo "Depth colors must be in #RRGGBB format" >&2
    usage >&2
    exit 1
  fi

  safe_config_path

  run_elevated sed -i \
    -e "s/^DEPTH_NEAR_COLOR=.*/DEPTH_NEAR_COLOR=$near_color/" \
    -e "s/^DEPTH_MID_COLOR=.*/DEPTH_MID_COLOR=$mid_color/" \
    -e "s/^DEPTH_FAR_COLOR=.*/DEPTH_FAR_COLOR=$far_color/" \
    "$CONFIG_FILE"

  reload_service_runtime
  exit $?
}

command="${1:-status}"
case "$command" in
  start|stop|restart|status)
    exec systemctl "$command" "$SERVICE"
    ;;
  logs)
    exec journalctl -u "$SERVICE" -n "${2:-100}" --no-pager
    ;;
  audio-status)
    exec "$AUDIO_STATUS_SCRIPT"
    ;;
  config)
    safe_config_path
    exec sed -n '/^[A-Z_][A-Z0-9_]*=.*/p' "$CONFIG_FILE"
    ;;
  mode)
    set_mode "${2:-}"
    ;;
  depth-colors)
    set_depth_colors "${2:-}" "${3:-}" "${4:-}"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac